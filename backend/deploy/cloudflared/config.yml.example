# Cloudflare Tunnel connector configuration — TEMPLATE, NOT REHEARSED.
#
# The tunnel is transport only. Cloudflare terminates TLS at the edge; the connector
# forwards to the loopback origin, so the host needs no inbound port and no TLS
# certificate of its own. The API still authenticates, rate limits, and bounds requests.
#
# Copy to /etc/cloudflared/config.yml, replace the placeholders, and keep the credentials
# JSON outside the repository, owned by root with mode 0600:
#   cloudflared tunnel login
#   cloudflared tunnel create manijero-pilot
#   cloudflared tunnel route dns manijero-pilot pilot.example.invalid
#   cloudflared tunnel run --config /etc/cloudflared/config.yml manijero-pilot
#
# Nothing here has been executed: no Cloudflare account, domain, tunnel, or DNS record
# exists in this repository.

tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_ID.json

# Connector health metrics for the operator only, on loopback.
metrics: 127.0.0.1:20241

ingress:
  - hostname: pilot.example.invalid
    service: http://127.0.0.1:8000
    originRequest:
      connectTimeout: 10s
      tlsTimeout: 10s
      keepAliveTimeout: 90s
      httpHostHeader: pilot.example.invalid
      # The origin is plain HTTP on loopback; the tunnel leg is encrypted by Cloudflare.
      noTLSVerify: false
  # Everything else is refused at the edge.
  - service: http_status:404
