{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/official-ingestion-document-v1.json",
  "title": "Quarantined extracted candidate document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "media_type", "extractor", "title", "blocks"],
  "properties": {
    "schema_version": {"const": "official-ingestion-document-v1"},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "media_type": {"enum": ["pdf", "html"]},
    "extractor": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "page", "section", "text"],
        "properties": {
          "kind": {"enum": ["heading", "text"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
