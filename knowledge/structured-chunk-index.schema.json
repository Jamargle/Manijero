{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/structured-chunk-index-v1.json",
  "title": "Derived structured-chunk index manifest",
  "description": "Readable contract for the manifest written last by backend/scripts/manage_structured_index.py. The index is derived, lives outside knowledge/, and is built only from legal-chunk-set-v1 chunk sets joined to approved catalog entries bound to human-approval evidence. It carries no timestamp, no absolute path, no chunk text, and no reviewer name. The answer service reads it only with MANIJERO_STRUCTURED_INDEX=on in local development or QA.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package_id", "approved_on", "merge_record_sha256"],
          "properties": {
            "kind": {"const": "merge_record"},
            "package_id": {"type": "string", "minLength": 1},
            "approved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "merge_record_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": {"const": "reviewed_git_baseline"},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        }
      ]
    },
    "chunk_set_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_id", "source_sha256", "chunk_set_sha256", "chunk_count"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/sha256"},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_set_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_count": {"type": "integer", "minimum": 0}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_sha256", "chunk_manifest_sha256", "chunk_sets", "as_of", "active_campaign"],
      "properties": {
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_sets": {"type": "array", "items": {"$ref": "#/$defs/chunk_set_entry"}},
        "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "active_campaign": {"type": "string", "pattern": "^\\d{4}$"}
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_catalog.json", "structured-passages.json", "bm25-index.json"],
      "properties": {
        "source_catalog.json": {"$ref": "#/$defs/file_entry"},
        "structured-passages.json": {"$ref": "#/$defs/file_entry"},
        "bm25-index.json": {"$ref": "#/$defs/file_entry"},
        "embedding-index.json": {"$ref": "#/$defs/file_entry"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "chunks", "indexed_passages"],
      "properties": {
        "documents": {"type": "integer", "minimum": 0},
        "chunks": {"type": "integer", "minimum": 0},
        "indexed_passages": {"type": "integer", "minimum": 0}
      }
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "embedding_index_sha256",
        "store_manifest_sha256",
        "documents_sha256",
        "vectors_sha256",
        "chromadb_version"
      ],
      "properties": {
        "model": {"type": "object"},
        "embedding_index_sha256": {"$ref": "#/$defs/sha256"},
        "store_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "documents_sha256": {"$ref": "#/$defs/sha256"},
        "vectors_sha256": {"$ref": "#/$defs/sha256"},
        "chromadb_version": {"type": "string", "minLength": 1}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "builder", "inputs", "approval", "files", "counts", "vectors"],
      "properties": {
        "schema_version": {"const": "structured-chunk-index-v1"},
        "builder": {"const": "manijero-structured-chunk-index-v1"},
        "inputs": {"$ref": "#/$defs/inputs"},
        "approval": {"$ref": "#/$defs/approval"},
        "files": {"$ref": "#/$defs/files"},
        "counts": {"$ref": "#/$defs/counts"},
        "vectors": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/vectors"}]}
      }
    }
  }
}
