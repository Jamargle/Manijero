{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/validity-review-v1.json",
  "title": "Source-validity review",
  "description": "Derived, read-only review of reviewed catalog expiry, publication and consolidation facts plus accepted change-impact signals. It proposes retirements, reviews and additions for a human; it is not canonical knowledge and applies no change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checker",
    "as_of",
    "inputs",
    "sources",
    "proposals",
    "summary",
    "review_gate",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": "validity-review-v1"},
    "checker": {"type": "string", "minLength": 1},
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Injected UTC calendar date used for every expiry and publication comparison. Never a wall-clock time."
    },
    "inputs": {"$ref": "#/$defs/inputs"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposal"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "review_gate": {"$ref": "#/$defs/review_gate"},
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "isoDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_sha256", "passages_sha256", "impact_report_sha256"],
      "properties": {
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "passages_sha256": {"$ref": "#/$defs/sha256"},
        "impact_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle_status", "expiry", "publication", "consolidation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "lifecycle_status": {"const": "current"},
        "expiry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "valid_until"],
          "properties": {
            "state": {"enum": ["expired", "in_force", "unknown"]},
            "valid_until": {
              "anyOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "published_on"],
          "properties": {
            "state": {"enum": ["published", "future", "unknown"]},
            "published_on": {
              "anyOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]
            }
          }
        },
        "consolidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["official_consolidated_text_linked", "unknown"]}
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "reasons", "instrument_keys", "review"],
      "properties": {
        "kind": {"enum": ["retirement", "review", "addition"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": {"enum": ["source", "candidate"]},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reason"}
        },
        "instrument_keys": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "passage_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "publication_url": {"type": "string", "pattern": "^https://"},
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "retirement"}}},
          "then": {
            "required": ["passage_ids"],
            "properties": {"target": {"properties": {"type": {"const": "source"}}}}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "review"}}},
          "then": {"required": ["source_ids"]}
        },
        {
          "if": {"properties": {"kind": {"const": "addition"}}},
          "then": {
            "required": ["title", "issuer", "publication_url"],
            "properties": {"target": {"properties": {"type": {"const": "candidate"}}}}
          }
        }
      ]
    },
    "reason": {
      "enum": [
        "expired_valid_until",
        "machine_evident_repeal",
        "ambiguous_signal",
        "negated_signal",
        "unmatched_repeal_target",
        "validity_signal",
        "linked_publication",
        "future_publication_date",
        "machine_evident_publication"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "applied"],
      "properties": {
        "required": {"const": true},
        "applied": {"const": false}
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_changes_applied",
        "automatic_retirement",
        "requires_human_approval"
      ],
      "properties": {
        "canonical_changes_applied": {"const": false},
        "automatic_retirement": {"const": false},
        "requires_human_approval": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "expired",
        "in_force",
        "expiry_unknown",
        "future_publications",
        "retirements",
        "additions",
        "reviews",
        "proposals"
      ],
      "properties": {
        "sources": {"type": "integer", "minimum": 0},
        "expired": {"type": "integer", "minimum": 0},
        "in_force": {"type": "integer", "minimum": 0},
        "expiry_unknown": {"type": "integer", "minimum": 0},
        "future_publications": {"type": "integer", "minimum": 0},
        "retirements": {"type": "integer", "minimum": 0},
        "additions": {"type": "integer", "minimum": 0},
        "reviews": {"type": "integer", "minimum": 0},
        "proposals": {"type": "integer", "minimum": 0}
      }
    }
  }
}
