# Manijero private pilot API configuration — TEMPLATE ONLY.
#
# Use: `sudo install -d -o root -g manijero -m 0750 /etc/manijero` and install this file as
# root:root 0600. It is read by backend/scripts/serve_pilot.py through systemd's
# EnvironmentFile= before the service drops to the service user; the development launcher
# does not load it.
#
# A tunnel is transport only: the origin stays on loopback and every access control
# below is enforced by the application.

# The hosted service only starts in the pilot profile. Do not change this to run the
# development launcher; ./scripts/init.sh --backend owns that path.
MANIJERO_DEPLOYMENT_PROFILE=pilot

# Required for /ask and /ready. Four digits, never inferred from the date or a question.
MANIJERO_ACTIVE_CAMPAIGN=2026

# Operator-managed client credentials (SHA-256 digests only). Create it with
#   sudo /opt/manijero/repo/backend/.venv/bin/python \
#     /opt/manijero/repo/backend/scripts/pilot_ops.py upsert-client \
#     --clients-file /etc/manijero/pilot-clients.json \
#     --client-id pilot-device --requests-per-minute 20 --token-stdin
# then give the file to the service account and check it is readable by it:
#   sudo chown manijero:manijero /etc/manijero/pilot-clients.json
#   sudo chmod 600 /etc/manijero/pilot-clients.json
#   sudo -u manijero test -r /etc/manijero/pilot-clients.json
# Ownership matters: /etc/manijero is root:manijero 0750, the clients file is
# manijero:manijero 0600, and a root-owned 0600 file fails closed with
# `clients_unreadable` because User=manijero opens it. This env file itself stays
# root:root 0600; systemd reads EnvironmentFile= before dropping to User=manijero.
MANIJERO_PILOT_CLIENTS_FILE=/etc/manijero/pilot-clients.json

# The reviewed design is Cloudflare Tunnel -> loopback origin. Binding a public
# interface additionally requires MANIJERO_PILOT_ALLOW_PUBLIC_BIND=1.
MANIJERO_PILOT_HOST=127.0.0.1
MANIJERO_PILOT_PORT=8000

# Worker processes. Per-client rate limits are enforced per process, so the effective
# allowance is requests_per_minute x workers.
MANIJERO_PILOT_WORKERS=2

# Protective bound, not a measured capacity figure.
MANIJERO_PILOT_MAX_CONCURRENCY=64

# Bounded request body. A general question is far below this; an all_active request with
# many lands is the case to raise it for.
MANIJERO_MAX_REQUEST_BYTES=65536

# Never set. The pilot launcher refuses reload mode; this line documents the refusal.
# MANIJERO_PILOT_ALLOW_PUBLIC_BIND=0
