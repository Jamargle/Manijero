{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/legal-markdown-document-v1.json",
  "title": "Derived Markdown document parsed from a quarantined official PDF",
  "description": "Readable provenance manifest for one parser artifact. It is derived review input outside knowledge/, never answerable knowledge. The Markdown file it names is the document text; this manifest carries no document text, timestamp, or absolute path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser",
    "candidate_id",
    "title",
    "source_sha256",
    "source_path",
    "upstream_extractor",
    "markdown_path",
    "markdown_sha256",
    "markdown_bytes",
    "page_count",
    "block_count",
    "character_count",
    "table_count",
    "ocr_page_count",
    "pages",
    "capabilities",
    "warnings",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": "legal-markdown-document-v1"},
    "parser": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": ["string", "null"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_path": {"type": "string", "minLength": 1, "description": "Relative to the quarantine root."},
    "upstream_extractor": {"type": "string", "minLength": 1},
    "markdown_path": {"type": "string", "minLength": 1, "description": "Relative to the output root."},
    "markdown_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "markdown_bytes": {"type": "integer", "minimum": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "block_count": {"type": "integer", "minimum": 0},
    "character_count": {"type": "integer", "minimum": 0},
    "table_count": {"type": "integer", "minimum": 0},
    "ocr_page_count": {"type": "integer", "minimum": 0},
    "previous_markdown_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "tables", "ocr"],
      "properties": {
        "layout": {"$ref": "#/$defs/capability"},
        "tables": {"$ref": "#/$defs/capability"},
        "ocr": {"$ref": "#/$defs/capability"}
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "signature"],
      "properties": {
        "profile": {"enum": ["base", "docparse"]},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "version"],
      "properties": {
        "status": {"enum": ["used", "not_needed", "unavailable", "failed"]},
        "reason": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "line_start", "line_end", "blocks", "tables", "ocr", "empty", "warnings"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "blocks": {"type": "integer", "minimum": 0},
        "tables": {"type": "integer", "minimum": 0},
        "ocr": {"type": "boolean"},
        "empty": {"type": "boolean"},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
