# Manijero QA settings: placeholder values only, no secret.
#
# Created by ./scripts/init.sh --qa-settings-setup on this computer. Lines that start with # are
# notes and are ignored. Run ./scripts/init.sh --environments-status to check this file.
# Nothing here is deployed and no server is contacted; the QA host is chosen later.

# The environment this file is for. Leave it as qa: a QA file is never treated as local.
MANIJERO_ENVIRONMENT=qa

# The service profile QA starts. Leave it as pilot: QA asks for an access key.
MANIJERO_DEPLOYMENT_PROFILE=pilot

# The PAC campaign year the answers use: four digits, for example 2026.
MANIJERO_ACTIVE_CAMPAIGN=2026

# The address people will use to reach QA. The word invalid in it marks a placeholder that never
# resolves; it is replaced when the QA server is chosen.
MANIJERO_PUBLIC_URL=https://qa.manijero.invalid

# The QA access keys made on this computer (digests only). Never share or move this folder.
MANIJERO_PILOT_CLIENTS_FILE=@QA_HOME@/credentials/pilot-clients.json

# QA's own published knowledge release folder, separate from the local one.
MANIJERO_KNOWLEDGE_RELEASE_ROOT=@QA_HOME@/knowledge-releases
