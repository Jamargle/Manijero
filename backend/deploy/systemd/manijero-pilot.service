# systemd unit for the Manijero private pilot API — TEMPLATE, NOT REHEARSED.
#
# This unit has not been installed on a host. It is the reviewed shape for an owned
# server reached only through a Cloudflare Tunnel connector (see backend/README.md).
# Replace /opt/manijero paths with the real checkout before use.
#
# Install:
#   cp backend/deploy/systemd/manijero-pilot.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now manijero-pilot.service
#
# File permissions (create these before the first start):
#   /etc/manijero                   root:manijero        0750
#   /etc/manijero/pilot.env         root:root            0600
#   /etc/manijero/pilot-clients.json manijero:manijero   0600
#
# The service user needs read access to the checkout and /etc/manijero/pilot-clients.json;
# systemd reads /etc/manijero/pilot.env as PID 1 before dropping privileges. The service
# needs no write access to knowledge/, which keeps the reviewed corpus read-only while the
# service runs. A corpus change is a deploy, not a runtime write.
#
# Canonical knowledge/source_catalog.json and knowledge/passages.json must be readable by
# User=manijero and every directory on the path must be traversable. The repository
# records them 0644; the pilot restore command writes 0644 so a sudo-run restore does not
# leave them root-owned 0600. After a restore, check before starting:
#   sudo -u manijero test -r /opt/manijero/repo/knowledge/source_catalog.json
#   sudo -u manijero test -r /opt/manijero/repo/knowledge/passages.json
#
# The clients file is opened by the process below as User=manijero: a root-owned 0600
# file makes ExecStartPre fail closed with `clients_unreadable`. After creating or
# rotating it, run:
#   sudo chown manijero:manijero /etc/manijero/pilot-clients.json
#   sudo chmod 600 /etc/manijero/pilot-clients.json
#   sudo -u manijero test -r /etc/manijero/pilot-clients.json

[Unit]
Description=Manijero private pilot API
Documentation=file:///opt/manijero/repo/backend/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manijero
Group=manijero
WorkingDirectory=/opt/manijero/repo
EnvironmentFile=/etc/manijero/pilot.env

# Preflight runs the explicit campaign, credentials, and corpus readiness checks before
# the service is allowed to accept traffic. A failed preflight fails the start.
ExecStartPre=/opt/manijero/repo/backend/.venv/bin/python /opt/manijero/repo/backend/scripts/serve_pilot.py --preflight-only
ExecStart=/opt/manijero/repo/backend/.venv/bin/python /opt/manijero/repo/backend/scripts/serve_pilot.py

Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGINT
# The application writes one request-metadata line per request to stdout; the journal is
# the operational record. Do not add RateLimitBurst=0 or forward logs to a third party.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=manijero-pilot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/manijero
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
