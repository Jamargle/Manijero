{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.local/schemas/knowledge-release-manifest.schema.json",
  "title": "Manijero knowledge release manifest (knowledge-release-v1)",
  "description": "Closed manifest written last into <root>/releases/<release_id>/release-manifest.json by backend/scripts/knowledge_release.py prepare. release_id is the first 16 hex characters of SHA-256 over the canonical JSON (sorted keys, no ASCII escaping, compact separators) of this document without release_id. The manifest carries no timestamp and no personal value; publish/rollback times live only in release-log.jsonl. Cross-field rules enforced by backend/app/knowledge_release.py and not expressible here: files[*].sha256 must equal the matching inputs/bm25/vector digests, gate.passed must equal (failures is empty), and release_id must equal the content id. Not a legal-coverage or answer-quality claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "inputs", "approval", "build", "files", "bm25", "vector", "gate", "statement"],
  "properties": {
    "schema_version": {"const": "knowledge-release-v1"},
    "release_id": {"$ref": "#/$defs/releaseId"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_sha256", "passages_sha256", "cases_sha256", "as_of", "active_campaign"],
      "properties": {
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "passages_sha256": {"$ref": "#/$defs/sha256"},
        "cases_sha256": {"$ref": "#/$defs/sha256"},
        "as_of": {"$ref": "#/$defs/isoDate"},
        "active_campaign": {"type": "string", "pattern": "^[0-9]{4}$"}
      }
    },
    "approval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package_id", "approved_on", "merge_record_sha256"],
          "properties": {
            "kind": {"const": "merge_record"},
            "package_id": {"type": "string", "minLength": 1},
            "approved_on": {"$ref": "#/$defs/isoDate"},
            "merge_record_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "description": "Operator assertion that the inputs equal a reviewed Git revision; the tool cannot verify it.",
          "properties": {
            "kind": {"const": "reviewed_git_baseline"},
            "revision": {"$ref": "#/$defs/gitRevision"}
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_revision", "python_version", "unicode_data_version", "bm25", "retrieval_k"],
      "properties": {
        "code_revision": {"$ref": "#/$defs/gitRevision"},
        "python_version": {"type": "string", "minLength": 1},
        "unicode_data_version": {"type": "string", "minLength": 1},
        "bm25": {
          "type": "object",
          "additionalProperties": false,
          "required": ["k1", "b"],
          "properties": {"k1": {"type": "number"}, "b": {"type": "number"}}
        },
        "retrieval_k": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "object",
      "required": ["source_catalog.json", "passages.json", "pac_answer_eval.json", "evaluation-report.json"],
      "propertyNames": {"enum": ["source_catalog.json", "passages.json", "pac_answer_eval.json", "bm25-index.json", "evaluation-report.json", "embedding-index.json"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "bm25": {
      "description": "Fingerprint of the BM25 statistics; null only when the gate failed before BM25 could be built. The service does not load bm25-index.json.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index_sha256", "document_count"],
          "properties": {
            "index_sha256": {"$ref": "#/$defs/sha256"},
            "document_count": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "vector": {
      "description": "Present only when a pre-built, up-to-date embedding index was packaged with a Chroma store. Chroma file bytes are not content-addressed; only content digests are recorded.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "embedding_index_sha256", "store_manifest_sha256", "documents_sha256", "vectors_sha256", "chromadb_version"],
          "properties": {
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model_id", "model_revision", "embedding_dimension", "pooling", "normalize", "dtype", "config_sha256"],
              "properties": {
                "model_id": {"type": "string"},
                "model_revision": {"type": "string"},
                "embedding_dimension": {"type": "integer", "minimum": 1},
                "pooling": {"type": "string"},
                "normalize": {"type": "boolean"},
                "dtype": {"type": "string"},
                "config_sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "embedding_index_sha256": {"$ref": "#/$defs/sha256"},
            "store_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "documents_sha256": {"$ref": "#/$defs/sha256"},
            "vectors_sha256": {"$ref": "#/$defs/sha256"},
            "chromadb_version": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failures", "baseline_release_id", "summary"],
      "properties": {
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_release_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/releaseId"}]},
        "summary": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["cases", "expected_state_agreement", "unexpected_answers"],
              "properties": {
                "cases": {"type": "integer", "minimum": 0},
                "expected_state_agreement": {"type": "integer", "minimum": 0},
                "unexpected_answers": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "statement": {"const": "Built from canonical reviewed artifacts. Not a legal-coverage or answer-quality claim."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "isoDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
