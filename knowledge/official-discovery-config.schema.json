{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/official-discovery-config-v1.json",
  "title": "Configured official discovery registries",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registries"],
  "properties": {
    "schema_version": {"const": "official-discovery-config-v1"},
    "registries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "issuer", "format", "url"],
        "properties": {
          "id": {"enum": ["boe", "boja"]},
          "issuer": {"enum": ["BOE", "Junta de Andalucía"]},
          "format": {"enum": ["boe-xml", "boja-json"]},
          "url": {"type": "string", "format": "uri", "pattern": "^https://(www\\.boe\\.es/datosabiertos/api/boe/sumario/[0-9]{8}|datos\\.juntadeandalucia\\.es/api/v0/boja/get/calendar\\?year=[0-9]{4})$"}
        }
      }
    }
  }
}
