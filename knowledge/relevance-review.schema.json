{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/relevance-review-v1.json",
  "title": "Candidate relevance review",
  "description": "Derived, suggest-only triage of discovered official-publication candidates by the pinned local model. It labels titles only, drops nothing, and changes no canonical knowledge; a person decides every candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classifier", "inputs", "candidates", "summary", "review_gate", "limits"],
  "properties": {
    "schema_version": {"const": "relevance-review-v1"},
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_version", "model", "model_digest"],
      "properties": {
        "instruction_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_state_sha256", "procedure_map_sha256"],
      "properties": {
        "discovery_state_sha256": {"$ref": "#/$defs/sha256"},
        "procedure_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "issuer", "title", "publication_url", "label", "topic", "reason", "truncated"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "issuer": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publication_url": {"type": "string", "minLength": 1},
          "label": {"enum": ["relevant", "not_relevant", "unsure"]},
          "topic": {
            "anyOf": [{"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, {"type": "null"}]
          },
          "reason": {
            "enum": ["model_suggestion", "instruction_like_text", "nominal_listing", "model_output_invalid", "model_error"]
          },
          "truncated": {"type": "boolean"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevant", "not_relevant", "unsure", "total"],
      "properties": {
        "relevant": {"type": "integer", "minimum": 0},
        "not_relevant": {"type": "integer", "minimum": 0},
        "unsure": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_drop", "canonical_changes_applied", "requires_human_decision"],
      "properties": {
        "automatic_drop": {"const": false},
        "canonical_changes_applied": {"const": false},
        "requires_human_decision": {"const": true}
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
