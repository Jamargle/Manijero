{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/legal-change-impact-report-v1.json",
  "title": "Legal source-change impact report",
  "description": "Derived, read-only analysis of quarantined official-document changes against the approved catalog, reviewed passages, and reviewed evaluation cases. It is not canonical knowledge and carries no approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer",
    "as_of",
    "inputs",
    "candidates",
    "summary",
    "review_gate",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": "legal-change-impact-report-v1"},
    "analyzer": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "review_gate": {"$ref": "#/$defs/review_gate"},
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingestion_state_sha256",
        "catalog_sha256",
        "passages_sha256",
        "evaluation_cases_sha256"
      ],
      "properties": {
        "ingestion_state_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "passages_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_cases_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_changes_applied", "automatic_retirement", "requires_human_approval"],
      "properties": {
        "canonical_changes_applied": {"const": false},
        "automatic_retirement": {"const": false},
        "requires_human_approval": {"const": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "issuer",
        "stable_identity",
        "title",
        "publication_url",
        "review_status",
        "ingestion_status",
        "version_status",
        "version",
        "signals",
        "potentially_affected",
        "review",
        "analysis_failure"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "issuer": {"type": "string", "minLength": 1},
        "stable_identity": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publication_url": {"type": "string", "pattern": "^https://"},
        "review_status": {"const": "pending"},
        "ingestion_status": {"enum": ["extracted", "failed", "rejected"]},
        "version_status": {
          "enum": [
            "no_extracted_document",
            "approved_copy",
            "unchanged_since_ingestion",
            "new_version",
            "baseline_unknown",
            "analysis_failed"
          ]
        },
        "version": {"$ref": "#/$defs/version"},
        "signals": {
          "type": "array",
          "items": {"$ref": "#/$defs/signal"}
        },
        "potentially_affected": {"$ref": "#/$defs/affected"},
        "review": {"$ref": "#/$defs/review"},
        "analysis_failure": {
          "anyOf": [
            {
              "enum": [
                "no_extracted_document",
                "missing_extracted_document",
                "extracted_text_mismatch",
                "malformed_extracted_document",
                "size_limit_exceeded",
                "internal_error"
              ]
            },
            {"type": "null"}
          ]
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_original_sha256",
        "previous_original_sha256",
        "baseline_text_available",
        "text_diff"
      ],
      "properties": {
        "current_original_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "previous_original_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "baseline_text_available": {"type": "boolean"},
        "text_diff": {
          "anyOf": [{"$ref": "#/$defs/text_diff"}, {"type": "null"}]
        }
      }
    },
    "text_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_added",
        "blocks_removed",
        "locations_changed",
        "text_changed",
        "excerpts"
      ],
      "properties": {
        "blocks_added": {"type": "integer", "minimum": 0},
        "blocks_removed": {"type": "integer", "minimum": 0},
        "locations_changed": {"type": "integer", "minimum": 0},
        "text_changed": {"type": "boolean"},
        "excerpts": {
          "type": "array",
          "items": {"$ref": "#/$defs/excerpt"}
        }
      }
    },
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "page", "section", "excerpt"],
      "properties": {
        "change": {"enum": ["added", "removed"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "classification",
        "reason",
        "page",
        "section",
        "excerpt",
        "instrument_keys",
        "introduced"
      ],
      "properties": {
        "kind": {"enum": ["repeal", "amendment", "validity", "publication"]},
        "classification": {"enum": ["machine_evident", "ambiguous"]},
        "reason": {
          "enum": [
            "negated_signal",
            "extraction_uncertainty",
            "no_named_instrument",
            "explicit_action_on_named_instrument",
            "no_explicit_date",
            "explicit_date",
            "explicit_publication_reference",
            "incomplete_publication_reference"
          ]
        },
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 280},
        "instrument_keys": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "introduced": {"type": ["boolean", "null"]}
      }
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "passages", "evaluation_cases"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reasons", "instrument_keys"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "candidate_version_differs_from_approved",
                    "repeal_target",
                    "amendment_target",
                    "validity_target"
                  ]
                }
              },
              "instrument_keys": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "passages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reasons"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {"enum": ["source_affected", "cites_target_instrument"]}
              }
            }
          }
        },
        "evaluation_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reasons"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {"enum": ["expected_source", "expected_passage"]}
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons", "automatic_retirement_allowed"],
      "properties": {
        "required": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "new_version",
              "baseline_unknown",
              "approved_copy_differs",
              "affected_source",
              "affected_passage",
              "previous_text_unavailable",
              "text_changed_without_signal",
              "ambiguous_signal",
              "conflicting_signals",
              "analysis_failed"
            ]
          }
        },
        "automatic_retirement_allowed": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "no_extracted_document",
        "approved_copy",
        "unchanged_since_ingestion",
        "new_version",
        "baseline_unknown",
        "analysis_failed",
        "review_required",
        "machine_evident_signals",
        "ambiguous_signals",
        "affected_sources",
        "affected_passages",
        "affected_evaluation_cases"
      ],
      "properties": {
        "candidates": {"type": "integer", "minimum": 0},
        "no_extracted_document": {"type": "integer", "minimum": 0},
        "approved_copy": {"type": "integer", "minimum": 0},
        "unchanged_since_ingestion": {"type": "integer", "minimum": 0},
        "new_version": {"type": "integer", "minimum": 0},
        "baseline_unknown": {"type": "integer", "minimum": 0},
        "analysis_failed": {"type": "integer", "minimum": 0},
        "review_required": {"type": "integer", "minimum": 0},
        "machine_evident_signals": {"type": "integer", "minimum": 0},
        "ambiguous_signals": {"type": "integer", "minimum": 0},
        "affected_sources": {"type": "integer", "minimum": 0},
        "affected_passages": {"type": "integer", "minimum": 0},
        "affected_evaluation_cases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
