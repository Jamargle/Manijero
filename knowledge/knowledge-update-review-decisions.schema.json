{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manijero.invalid/schemas/knowledge-update-review-decisions-v1.json",
  "title": "Manijero knowledge-update review decisions",
  "description": "Ordered human decisions recorded for one draft review package. It preserves reviewer identity, decision, date, and note. Approval is a named human decision other than the package author; a bot identity, label, CI result, or matching hash is never approval. The readable contract; backend/app/review_package.py is the executable writer and must stay in sync with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "author",
    "checks_digest",
    "history",
    "effective_decision",
    "approved_by"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-update-review-decisions-v1"},
    "package_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "automation"]}
      }
    },
    "checks_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "reviewer",
          "decision",
          "decided_on",
          "note",
          "package_id",
          "checks_digest"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "decision": {"enum": ["approve", "request_changes", "reject"]},
          "decided_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "note": {"type": "string"},
          "package_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "checks_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "effective_decision": {
      "enum": ["approved", "changes_requested", "rejected", null]
    },
    "approved_by": {"type": ["string", "null"]}
  }
}
